      "css": ".ds-stat{display:grid;gap:.4rem;padding:.85rem;background:var(--panel,#1b2022);border:1px solid var(--border,#2a3032);border-radius:1.1rem;min-width:140px;font-family:system-ui,sans-serif;color:#f5f7f8}.ds-stat-l{font-size:.72rem;letter-spacing:.05em;text-transform:uppercase;opacity:.65}.ds-stat-v{font-size:2.25rem;line-height:1;font-weight:600;color:var(--accent,#2fb8a4);font-variant-numeric:tabular-nums}.ds-stat-p{font-size:.72rem;opacity:.55}"
