      "html": "<label class=\"ds-field\"><span>Birth Date</span><input class=\"ds-input\" type=\"date\"></label>",
      "css": ".ds-field{display:grid;gap:.25rem;font:500 1rem system-ui,sans-serif;color:#f5f7f8}.ds-input{background:var(--panel,#1b2022);border:1px solid var(--border,#2a3032);border-radius:.55rem;padding:.65rem .8rem;color:#f5f7f8;font:400 1rem system-ui,sans-serif}.ds-input:focus-visible{outline:2px solid var(--accent,#2fb8a4);outline-offset:2px}"
    },
