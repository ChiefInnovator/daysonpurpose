      "description": "The single Calculate action.",
      "html": "<button class=\"ds-btn-primary\">Calculate</button>",
      "css": ".ds-btn-primary{background:var(--accent,#2fb8a4);color:#0f1214;border:none;padding:.85rem 1.2rem;font:600 1rem system-ui,sans-serif;border-radius:.65rem;cursor:pointer;transition:filter .2s}.ds-btn-primary:hover{filter:brightness(1.08)}.ds-btn-primary:active{filter:brightness(.93)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#2fb8a4);outline-offset:2px}.ds-btn-primary[disabled]{opacity:.55;cursor:not-allowed}"
