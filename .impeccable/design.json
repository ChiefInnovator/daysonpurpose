      "description": "Container for the answer; the only teal-framed surface.",
      "html": "<div class=\"ds-result\"><h2>Your Purpose Days</h2><p>Approximate days for your journey, based on current averages.</p></div>",
      "css": ".ds-result{display:grid;gap:.4rem;padding:1.75rem 1.6rem 1.9rem;background:#15191b;border:1px solid var(--accent,#2fb8a4);border-radius:1rem;color:#f5f7f8;font-family:system-ui,sans-serif}.ds-result h2{margin:0;font-size:2.15rem;line-height:1.15}.ds-result p{margin:0;opacity:.8;font-size:1.1rem}"
